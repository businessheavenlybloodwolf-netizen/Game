{
  "name": "haptics-bridge",
  "version": "1.2.0",
  "description": "Lässt Geräte über Intiface vibrieren, wenn man in Spielen Schaden nimmt",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node bridge.mjs",
    "dry": "node bridge.mjs --dry",
    "vrchat": "node bridge.mjs --vrchat",
    "hit": "node tools/send.mjs damage 30"
  }
}
